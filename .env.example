# Copy this file to `.env.local` and fill in the keys you have.
# EvalLens works without any keys — the mock provider will simulate responses.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override default model ids
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_MODEL=claude-opus-4-20250514

# Optional: pick which model judges the others (LLM-as-Judge).
# Leave unset to auto-pick whichever real key is available (OpenAI preferred).
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o

# Demo mode — set EVALLENS_DEMO=1 to force mock-only providers and disable
# the LLM judge. Useful for public deployments (e.g. Vercel) so visitors can
# play with the UI without burning your API quota.
# On Vercel, demo mode is enabled by default. Set EVALLENS_DEMO=0 to opt out.
# EVALLENS_DEMO=1
